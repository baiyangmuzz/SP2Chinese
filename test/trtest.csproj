<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>trtest</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Main.cs" />
    <!-- 用 MSBuild 属性定位仓库根目录，不再依赖 "..\..\..\SP2Chinese" 这种绑死目录名的路径 -->
    <Compile Include="$(MSBuildThisFileDirectory)..\src\Translator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\src\DictionaryUpdater.cs" />
  </ItemGroup>
</Project>