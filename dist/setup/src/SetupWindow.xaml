<Window x:Class="SP2Chinese.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimplePlanes 2 汉化管理器"
        Width="1000" Height="640"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
      结构：单块 Border 统一画「圆角 + 描边 + 背景」，内层同圆角 Border 裁内容。
      不要在外面留透明 Margin：AllowsTransparency 下那块透明边会透出桌面，
      看起来像窗口外多出一个方框。
    -->
    <Grid x:Name="RootGrid" Background="Transparent"
          MouseLeftButtonDown="RootGrid_OnMouseLeftButtonDown"
          MouseMove="RootGrid_OnMouseMove"
          MouseLeftButtonUp="RootGrid_OnMouseLeftButtonUp">
        <Border Background="{StaticResource BgBrush}" CornerRadius="14"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Border CornerRadius="13" ClipToBounds="True">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- Header -->
                    <RowDefinition Height="*" />      <!-- 主体分栏 -->
                </Grid.RowDefinitions>

                <!-- ══ Header ══
                     拖动由窗口根容器 RootGrid 统一处理（手动捕获鼠标） -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="24,20,24,20"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="SimplePlanes 2 汉化管理器"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="18" FontWeight="SemiBold" />
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" Text="v1.6.3"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="1"
                            Width="30" Height="30" VerticalAlignment="Center" Cursor="Hand"
                            ToolTip="关闭">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource DimBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FF2A1A1C" />
                                        <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ 主体：左面板 + 右日志 ══ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ── 左侧：状态与操作 ── -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                  BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,1,0">
                        <StackPanel Margin="24,20,24,20">
                            <TextBlock Text="当前状态" Style="{StaticResource SectionTitle}" />

                            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 状态行：圆点 + 文字 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                                 Fill="{StaticResource OkBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusText" Text="正在查找游戏目录…"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="{StaticResource UiFont}" FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 游戏目录 -->
                                    <Border Grid.Row="1" Background="{StaticResource LogBrush}"
                                            CornerRadius="6" Padding="8,6"
                                            BorderBrush="{StaticResource BorderBrush2}"
                                            BorderThickness="1" Margin="0,0,0,14">
                                        <TextBlock x:Name="PathText" Text=""
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Border>

                                    <!-- 进度条 -->
                                    <Border Grid.Row="2" Height="6" Background="{StaticResource BgBrush}"
                                            CornerRadius="3" ClipToBounds="True"
                                            x:Name="ProgressTrack" SizeChanged="OnTrackSizeChanged">
                                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                                                CornerRadius="3" Background="{StaticResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <TextBlock Text="操作" Style="{StaticResource SectionTitle}" />

                            <StackPanel>
                                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}"
                                        Content="开始安装" HorizontalAlignment="Stretch"
                                        Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="UpdateButton" Grid.Column="0"
                                            Style="{StaticResource GhostButton}" Content="检查更新" />
                                    <Button x:Name="RollbackButton" Grid.Column="2"
                                            Style="{StaticResource GhostButton}" Content="回滚版本" />
                                </Grid>

                                <Button x:Name="UninstallButton" Style="{StaticResource DangerButton}"
                                        Content="卸载汉化" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 自更新提示条 -->
                            <Border x:Name="SelfUpdateBar" Background="#FF1C2A44"
                                    BorderBrush="#FF2D4A7A" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,20,0,0"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="SelfUpdateText"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="SelfUpdateButton"
                                            Style="{StaticResource AccentButton}" Content="立即更新"
                                            Height="32" Padding="14,0" FontSize="13"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Star 提示：装完才显示 -->
                            <TextBlock x:Name="StarHint" Margin="0,20,0,0"
                                       Foreground="{StaticResource DimBrush}"
                                       FontFamily="{StaticResource UiFont}" FontSize="12"
                                       LineHeight="18" Visibility="Collapsed" TextWrapping="Wrap">
                                <Run Text="如果这个汉化帮到了你，欢迎去 " />
                                <Run Text="GitHub 点个 Star" Foreground="#FFD8B44E" Cursor="Hand"
                                     MouseLeftButtonDown="RepoLink_OnClick" />
                                <Run Text="，让更多玩家能搜到它（免费的，就一下下）。" />
                            </TextBlock>

                            <!-- 底部声明 -->
                            <StackPanel Margin="0,24,0,0">
                                <TextBlock Foreground="{StaticResource DimBrush}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           LineHeight="17">
                                    <Run Text="词库版本：" /><Run x:Name="DictInfoRun" Text="" /><LineBreak />
                                    <Run Text="本软件开源免费，若有人向你收费即为诈骗。" />
                                </TextBlock>
                                <TextBlock Margin="0,10,0,0" FontSize="12" LineHeight="19"
                                           FontFamily="{StaticResource UiFont}">
                                    <Run Text="反馈与支持：" Foreground="{StaticResource DimBrush}" /><LineBreak />
                                    <Run Text="GitHub: baiyangmuzz/SP2Chinese" Foreground="#FF8FB8E8"
                                         Cursor="Hand" MouseLeftButtonDown="RepoLink_OnClick" /><LineBreak />
                                    <Run Text="QQ 群：1128992783（点击复制）" Foreground="#FF8FB8E8"
                                         Cursor="Hand" MouseLeftButtonDown="QqLink_OnClick" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── 右侧：控制台日志 ──
                         右下角必须自己圆：窗口的 ClipToBounds 只裁矩形，
                         日志背景若直伸到窗口圆角处，方角会戳出圆角外 -->
                    <Border Grid.Column="1" Background="{StaticResource LogBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,1,0,0"
                            CornerRadius="0,0,12,0">
                        <Grid Margin="24,20,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="控制台日志 (Console Output)"
                                           Foreground="{StaticResource DimBrush}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="UTF-8"
                                           Foreground="{StaticResource DimBrush}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            </Grid>

                            <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="LogText"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" LineHeight="23"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
