<Window x:Class="SP2Chinese.Setup.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要回滚的版本"
        Width="560" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="13">
            <Grid Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="回滚到历史版本"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="19" FontWeight="Bold" />

                <TextBlock Grid.Row="1" Margin="0,8,0,0"
                           Text="选一个备份。当前版本会先自动备份，随时可以再回滚回来。"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12" TextWrapping="Wrap" />

                <Border Grid.Row="2" Background="{StaticResource LogBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                        Margin="0,16,0,0" Padding="8">
                    <!--
                      用 ListBox + 关闭虚拟化：备份最多 6 条，不需要虚拟化，
                      而且 RenderTargetBitmap 抓不到虚拟化项的内容（截图会只剩空条）。
                    -->
                    <ListBox x:Name="HistoryList"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource DimBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <!-- 选中项高亮 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" CornerRadius="7" Background="Transparent"
                                                    Margin="2,1" Padding="0">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF2C3D55" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF262B35" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <TextBlock x:Name="EmptyHint" Grid.Row="2"
                           Text="没有可回滚的历史备份。每次安装会自动保留最近 3 份。"
                           Foreground="{StaticResource DimBrush}"
                           FontFamily="{StaticResource UiFont}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Grid.Column="1"
                            Style="{StaticResource GhostButton}" Content="取消" MinWidth="88" />
                    <Button x:Name="OkButton" Grid.Column="2"
                            Style="{StaticResource AccentButton}" Content="回滚到这个版本"
                            MinWidth="140" Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
